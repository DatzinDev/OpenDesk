# Oauth2 credentials for Google API access
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Servicio SMTP google
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=contacto@datzin.com.mx
MAIL_PASSWORD=tu_app_password
MAIL_FROM=contacto@datzin.com.mx
MAIL_FROM_NAME=Datzin
MAIL_USE_TLS=true

# Admin
ADMIN_EMAIL=contacto@datzin.com.mx

# Aplicación
APP_URL=http://localhost:8080
SECRET_KEY=cambia_esto_por_un_valor_aleatorio
POSTGRES_PASSWORD=cambia_esto

# Opcionales
# APP_TIMEZONE=America/Mexico_City
# REMINDER_HOURS=24
# WEB_PORT=8087

# Desarrollo: carga áreas, personas y tickets ficticios (api/seeds/dev.sql) al iniciar
DEV_SEED=false

# Adjuntos (SeaweedFS compatible con S3, servicio "storage" de Docker Compose)
S3_ACCESS_KEY=opendesk
S3_SECRET_KEY=cambia_esto
S3_BUCKET=opendesk
